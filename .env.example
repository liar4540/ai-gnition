# Copy this file to .env and fill in the values. .env is git-ignored; never commit real values.
# Real secrets go into Orchestrate connections (see docs/IMPLEMENTATION_PLAN.md, "Placeholders").
# Keep the double quotes: scripts/deploy.sh sources this file with bash.

# watsonx Orchestrate (needed from Step 0 deploy)
WXO_SERVER_URL="<WXO_SERVER_URL>"
WXO_API_KEY="<WXO_API_KEY>"

# Telegram approval bot (needed for the Step 6 live test)
TELEGRAM_BOT_TOKEN="<TELEGRAM_BOT_TOKEN>"
TELEGRAM_CHAT_ID="<TELEGRAM_CHAT_ID>"

# Google OAuth client (needed from Step 2 / Step 7)
GOOGLE_CLIENT_ID="<GOOGLE_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<GOOGLE_CLIENT_SECRET>"
# Filled automatically by: venv\Scripts\python scripts\get_google_refresh_token.py read   (and ... act)
GOOGLE_READ_REFRESH_TOKEN="<GOOGLE_READ_REFRESH_TOKEN>"
GOOGLE_ACT_REFRESH_TOKEN="<GOOGLE_ACT_REFRESH_TOKEN>"

# Optional: local SQLite path for tests on Windows (default /tmp/nyp_inbox.db)
NYP_DB_PATH=""
